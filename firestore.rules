rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── HELPERS ──────────────────────────────────────────────────────────────
    function isAdmin() {
      return request.auth != null
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isDomiciliario() {
      return request.auth != null
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'domiciliario';
    }

    // Id del documento en /domiciliarios/ que corresponde al usuario autenticado
    // (distinto del uid de Auth — ver users/{uid}.domiciliarioId)
    function myDomiciliarioId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.domiciliarioId;
    }

    // ── USUARIOS ─────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read:  if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create: if (request.auth != null && request.auth.uid == userId
                        && (!('role' in request.resource.data)
                            || (request.resource.data.role == 'admin'
                                && !exists(/databases/$(database)/documents/config/adminReady))))
                    || isAdmin();
      allow update: if (request.auth != null && request.auth.uid == userId
                    && !('role' in request.resource.data))
                    || isAdmin();
      allow delete: if isAdmin();
    }

    // ── CONFIGURACIÓN ────────────────────────────────────────────────────────
    match /config/{docId} {
      allow read:  if docId == 'main' || docId == 'colores' || docId == 'delivery_settings' || isAdmin();
      allow write: if isAdmin()
                   || (docId == 'adminReady'
                       && !exists(/databases/$(database)/documents/config/adminReady));
    }

    // ── CONFIGURACIÓN PRIVADA (PINs — solo admin) ────────────────────────────
    match /config/adminSettings {
      allow read:  if isAdmin();
      allow write: if isAdmin();
    }

    // ── CATEGORÍAS ───────────────────────────────────────────────────────────
    match /categorias/{catId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── PRODUCTOS ────────────────────────────────────────────────────────────
    match /productos/{prodId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── PEDIDOS ──────────────────────────────────────────────────────────────
    match /pedidos/{pedidoId} {
      allow create: if request.resource.data.keys().hasAll(['items', 'total', 'cliente', 'estado'])
                    && request.resource.data.total is number
                    && request.resource.data.total > 0
                    && request.resource.data.total < 10000000
                    && request.resource.data.items is list
                    && request.resource.data.items.size() > 0
                    && request.resource.data.items.size() < 50;
      allow read:   if isAdmin() || isDomiciliario();
      allow update: if isAdmin()
                    || (isDomiciliario()
                        && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['estado', 'rutaNombre', 'repartidorNombre', 'domiciliarioId', 'notaPendiente']));
      allow delete: if isAdmin();
    }

    // ── CUPONES ──────────────────────────────────────────────────────────────
    match /cupones/{cuponId} {
      allow get:    if true;
      allow list:   if isAdmin();
      allow delete: if isAdmin();
      // Admin siempre puede crear; clientes (incluso sin auth) pueden crear cupones
      // generados automáticamente por promociones compra_cupon — el % de descuento
      // (valor) debe coincidir EXACTO con el que el admin configuró en esa
      // promoción real y activa. Antes no se validaba `valor`, así que cualquiera
      // podía crearse un cupón con el descuento que quisiera (ej. 100%).
      allow create: if isAdmin()
                    || (request.resource.data.origen == 'promo'
                        && request.resource.data.activo == true
                        && request.resource.data.usos == 0
                        && request.resource.data.limite == 1
                        && request.resource.data.tipo == 'porcentaje'
                        && request.resource.data.promoId is string
                        && get(/databases/$(database)/documents/promociones/$(request.resource.data.promoId)).data.activa == true
                        && get(/databases/$(database)/documents/promociones/$(request.resource.data.promoId)).data.tipo == 'compra_cupon'
                        && request.resource.data.valor == get(/databases/$(database)/documents/promociones/$(request.resource.data.promoId)).data.cuponPct);
      // Admin puede actualizar cualquier campo; clientes solo pueden incrementar usos
      allow update: if isAdmin()
                    || (request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['usos'])
                        && request.resource.data.usos == resource.data.usos + 1);
    }

    // ── NOVEDADES ────────────────────────────────────────────────────────────
    match /novedades/{novId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── ADICIONALES ──────────────────────────────────────────────────────────
    match /adicionales/{adicionalId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── PUBLICIDADES ─────────────────────────────────────────────────────────
    match /publicidades/{pubId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── BARRIOS ──────────────────────────────────────────────────────────────
    match /barrios/{barrioId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── DOMICILIARIOS ────────────────────────────────────────────────────────
    match /domiciliarios/{domId} {
      allow read:  if isAdmin() || isDomiciliario();
      allow write: if isAdmin();
    }

    // ── RUTAS DE ENTREGA ─────────────────────────────────────────────────────
    // Un domiciliario solo puede leer/crear/modificar/eliminar SUS PROPIAS rutas
    // (antes cualquier domiciliario autenticado podía tocar las rutas de otro)
    match /rutas/{rutaId} {
      allow read:   if isAdmin()
                    || (isDomiciliario() && resource.data.domiciliarioId == myDomiciliarioId());
      allow create: if isAdmin()
                    || (isDomiciliario() && request.resource.data.domiciliarioId == myDomiciliarioId());
      allow update: if isAdmin()
                    || (isDomiciliario() && resource.data.domiciliarioId == myDomiciliarioId());
      allow delete: if isAdmin()
                    || (isDomiciliario() && resource.data.domiciliarioId == myDomiciliarioId());
    }

    // ── HISTORIAL DE PEDIDOS ─────────────────────────────────────────────────
    match /historial_pedidos/{diaId} {
      allow read:  if isAdmin() || isDomiciliario();
      allow write: if isAdmin();
    }

    // ── HISTORIAL DE RUTAS (creado por domiciliarios al cerrar ruta) ─────────
    // Un domiciliario solo puede leer/crear su propio historial
    match /historial_rutas/{rutaId} {
      allow read:   if isAdmin()
                    || (isDomiciliario() && resource.data.domiciliarioId == myDomiciliarioId());
      allow create: if isAdmin()
                    || (isDomiciliario() && request.resource.data.domiciliarioId == myDomiciliarioId());
      allow delete: if isAdmin();
    }

    // ── NOTIFICACIONES ───────────────────────────────────────────────────────
    match /notificaciones/{domId}/items/{notifId} {
      allow read, update: if isAdmin() || isDomiciliario();
      allow create:       if isAdmin() || isDomiciliario();
      allow delete:       if isAdmin();
    }

    // ── PROMOCIONES ──────────────────────────────────────────────────────────
    match /promociones/{promoId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── BLOQUEAR TODO LO DEMÁS ───────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
