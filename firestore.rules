rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── HELPERS ──────────────────────────────────────────────────────────────
    function isAdmin() {
      return request.auth != null
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isDomiciliario() {
      return request.auth != null
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'domiciliario';
    }

    function myDomiciliarioId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.domiciliarioId;
    }

    // ── USUARIOS ─────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read:  if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
                    && (!('role' in request.resource.data)
                        || (request.resource.data.role == 'admin'
                            && !exists(/databases/$(database)/documents/config/adminReady)));
      allow update: if (request.auth != null && request.auth.uid == userId
                    && !('role' in request.resource.data))
                    || isAdmin();
      allow delete: if isAdmin();
    }

    // ── CONFIGURACIÓN ────────────────────────────────────────────────────────
    match /config/{docId} {
      allow read:  if docId == 'main' || docId == 'colores' || docId == 'delivery_settings' || isAdmin();
      allow write: if isAdmin()
                   || (docId == 'adminReady'
                       && !exists(/databases/$(database)/documents/config/adminReady));
    }

    // ── CATEGORÍAS ───────────────────────────────────────────────────────────
    match /categorias/{catId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── PRODUCTOS ────────────────────────────────────────────────────────────
    match /productos/{prodId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── PEDIDOS ──────────────────────────────────────────────────────────────
    match /pedidos/{pedidoId} {
      allow create: if true;
      allow read:   if isAdmin() || isDomiciliario();
      allow update: if isAdmin()
                    || (isDomiciliario()
                        && resource.data.domiciliarioId == myDomiciliarioId()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'rutaNombre', 'repartidorNombre']));
      allow delete: if isAdmin();
    }

    // ── CUPONES ──────────────────────────────────────────────────────────────
    match /cupones/{cuponId} {
      allow read:           if true;
      allow create, delete: if isAdmin();
      allow update:         if isAdmin()
                            || (request.auth == null
                                && request.resource.data.diff(resource.data).affectedKeys()
                                   .hasOnly(['usos'])
                                && request.resource.data.usos == resource.data.usos + 1);
    }

    // ── NOVEDADES ────────────────────────────────────────────────────────────
    match /novedades/{novId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── ADICIONALES ──────────────────────────────────────────────────────────
    match /adicionales/{adicionalId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── PUBLICIDADES ─────────────────────────────────────────────────────────
    match /publicidades/{pubId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── BARRIOS ──────────────────────────────────────────────────────────────
    match /barrios/{barrioId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── DOMICILIARIOS ────────────────────────────────────────────────────────
    match /domiciliarios/{domId} {
      allow read:  if isAdmin() || isDomiciliario();
      allow write: if isAdmin();
    }

    // ── RUTAS DE ENTREGA ─────────────────────────────────────────────────────
    match /rutas/{rutaId} {
      allow read:   if isAdmin() || isDomiciliario();
      allow create: if isAdmin()
                    || (isDomiciliario()
                        && request.resource.data.domiciliarioId == myDomiciliarioId());
      allow update: if isAdmin()
                    || (isDomiciliario()
                        && resource.data.domiciliarioId == myDomiciliarioId());
      allow delete: if isAdmin();
    }

    // ── HISTORIAL DE PEDIDOS ─────────────────────────────────────────────────
    match /historial_pedidos/{diaId} {
      allow read:  if isAdmin() || isDomiciliario();
      allow write: if isAdmin();
    }

    // ── NOTIFICACIONES ───────────────────────────────────────────────────────
    match /notificaciones/{domId}/items/{notifId} {
      allow read, update: if isAdmin()
                          || (isDomiciliario() && myDomiciliarioId() == domId);
      allow create:       if isAdmin() || isDomiciliario();
      allow delete:       if isAdmin();
    }

    // ── PROMOCIONES ──────────────────────────────────────────────────────────
    match /promociones/{promoId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── BLOQUEAR TODO LO DEMÁS ───────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
