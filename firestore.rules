rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── HELPER: verifica si el usuario autenticado tiene rol admin ──
    // El campo "role" se asigna desde la consola Firebase o desde una
    // Cloud Function al crear el usuario. Nunca desde el cliente.
    function isAdmin() {
      return request.auth != null
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ── USUARIOS — cada uno lee/escribe solo su propio doc ──
    // El campo "role" SOLO puede ser escrito por admins existentes.
    match /users/{userId} {
      allow read:  if request.auth != null && request.auth.uid == userId;
      // Bootstrap: permite rol 'admin' solo si aún no existe config/adminReady
      allow create: if request.auth != null && request.auth.uid == userId
                    && (!('role' in request.resource.data)
                        || (request.resource.data.role == 'admin'
                            && !exists(/databases/$(database)/documents/config/adminReady)));
      allow update: if (request.auth != null && request.auth.uid == userId
                    && !('role' in request.resource.data))
                    || isAdmin();
      allow delete: if isAdmin();
    }

    // ── CONFIGURACIÓN ──
    // main y colores: lectura pública (nombre del comercio, logo, tema)
    // adminReady: solo admin (documento de bootstrap)
    match /config/{docId} {
      allow read:  if docId == 'main' || docId == 'colores' || isAdmin();
      allow write: if isAdmin()
                   || (docId == 'adminReady'
                       && !exists(/databases/$(database)/documents/config/adminReady));
    }

    // ── CATEGORÍAS — lectura pública, escritura solo admin ──
    match /categorias/{catId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── PRODUCTOS — lectura pública, escritura solo admin ──
    match /productos/{prodId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── PEDIDOS ──
    // Crear: cualquiera puede hacer un pedido (cliente sin login)
    // Leer/actualizar/eliminar: solo admin
    match /pedidos/{pedidoId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ── CUPONES ──
    // Lectura pública (validar código en checkout sin exponer config interna)
    // Crear/eliminar: solo admin
    // Update: SOLO admin — se eliminó "if true" que permitía alterar descuentos
    // El incremento de usos ahora se hace desde una Cloud Function o con
    // una regla de campo específica (ver README → Cupones seguros).
    match /cupones/{cuponId} {
      allow read:          if true;
      allow create, delete: if isAdmin();
      allow update:        if isAdmin()
                           || (request.auth == null
                               && request.resource.data.diff(resource.data).affectedKeys()
                                  .hasOnly(['usos'])
                               && request.resource.data.usos == resource.data.usos + 1);
    }

    // ── NOVEDADES — lectura pública, escritura solo admin ──
    match /novedades/{novId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── ADICIONALES — lectura pública, escritura solo admin ──
    match /adicionales/{adicionalId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── PUBLICIDADES — lectura pública, escritura solo admin ──
    match /publicidades/{pubId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── RUTAS DE ENTREGA — solo admin ──
    match /rutas/{rutaId} {
      allow read, write: if isAdmin();
    }

    // ── HISTORIAL DE PEDIDOS — solo admin ──
    match /historial_pedidos/{diaId} {
      allow read, write: if isAdmin();
    }

    // ── BLOQUEAR TODO LO DEMÁS ──
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
