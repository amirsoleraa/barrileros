# Firebase — copia estas variables en Netlify → Site Settings → Environment Variables
# Renombra de FIREBASE_* a VITE_FIREBASE_* (Vite expone solo variables con prefijo VITE_)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloudinary — subida de imágenes sin necesidad de plan pago en Firebase Storage
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# EmailJS (opcional — si no configuras, los emails se omiten silenciosamente)
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
