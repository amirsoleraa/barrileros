# Supabase — copia estas variables en Netlify/Vercel → Environment Variables
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Cloudinary — subida de imágenes
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# EmailJS (opcional — si no configuras, los emails se omiten silenciosamente)
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=

# Google Maps — habilitar en Google Cloud: Maps JavaScript API + Places API
VITE_GOOGLE_MAPS_API_KEY=

# Sentry (monitoreo de errores) — DSN de tu proyecto en sentry.io. Opcional:
# sin esta variable la app funciona igual, solo sin reportar errores.
VITE_SENTRY_DSN=
